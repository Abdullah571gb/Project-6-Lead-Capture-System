        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a lead qualification specialist. Analyze the lead information and determine if they are qualified.\\n\\nQualification rules:\\n- QUALIFIED if budget is Medium or High AND they have a clear specific need\\n- NOT QUALIFIED if budget is Low OR message is vague OR seems like spam\\n\\nReturn ONLY a JSON object with no other text:\\n{\\n  \\\"qualified\\\": \\\"YES\\\" or \\\"NO\\\",\\n  \\\"score\\\": number from 1 to 10,\\n  \\\"reason\\\": \\\"one sentence explanation\\\",\\n  \\\"priority\\\": \\\"HIGH\\\" or \\\"MEDIUM\\\" or \\\"LOW\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"=Name: {{$json.lead_name}}\\nCompany: {{$json.lead_company}}\\nBudget: {{$json.lead_budget}}\\nMessage: {{$json.lead_message}}\\nSource: {{$json.lead_source}}\"\n    }\n  ],\n  \"max_tokens\": 300,\n  \"temperature\": 0.3\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        512,
        -96
      ],
      "id": "61e6c227-d344-459b-8fcd-d5af24a3754a",
      "name": "HTTP Request1",
      "retryOnFail": true,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json.choices[0].message.content;\n\n// Clean the response — remove any markdown if present\nconst cleaned = aiResponse.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// Parse the JSON\nconst qualification = JSON.parse(cleaned);\n\n// Get the lead data from earlier in the workflow\nconst leadData = $('Set node').first().json;\n\nreturn [{\n  json: {\n    ...leadData,\n    qualified: qualification.qualified,\n    score: qualification.score,\n    reason: qualification.reason,\n    priority: qualification.priority\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
