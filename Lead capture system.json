        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional business development manager. Write a warm, personalized response email to a qualified lead.\\n\\nThe email should:\\n- Address them by first name\\n- Reference their specific need\\n- Briefly mention how you can help\\n- Propose a 20 minute discovery call\\n- Be friendly but professional\\n- Sign the email as Muhammad Abdullah\\n- Maximum 150 words\\n\\nReturn ONLY a raw, valid JSON object. Do not include any markdown formatting like ```json. You MUST properly escape all newlines inside the email body string using '\\\\n' instead of literal line breaks.\\n\\n{\\n  \\\"subject\\\": \\\"email subject line\\\",\\n  \\\"body\\\": \\\"full email body\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"=Lead Name: {{$json.lead_name}}\\nCompany: {{$json.lead_company}}\\nTheir Need: {{$json.lead_message}}\\nBudget Level: {{$json.lead_budget}}\\nQualification Score: {{$json.score}}/10\"\n    }\n  ],\n  \"max_tokens\": 500,\n  \"temperature\": 0.7\n}",
        "options": {}
